{
  "manifest_version": 3,
  "name": "Magazine New Tab",
  "version": "1.0.0",
  "description": "An editorial digital magazine new tab page with realistic open-spread spine curvature and stacked page depth.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "bookmarks",
    "topSites",
    "favicon"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Magazine New Tab"
  }
}
